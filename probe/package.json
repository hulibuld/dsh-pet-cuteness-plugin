{
  "name": "dsh-pet-cuteness-plugin",
  "version": "0.2.1",
  "description": "dsh-pet 的附属插件（不能单独运行）：按模型套用二次元人格、思维链中文化、台词与日记，让右下角那只鲸鱼娘有话说。",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./src/*": "./src/*"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "data/personas.zh.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README-安装.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "external": [],
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@linxin666/dsh-pet": ">=0.4.8"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "author": "Yuzhou (https://github.com/hulibuld)",
  "license": "MIT",
  "scripts": {
    "prepare": "node scripts/build-client.mjs",
    "build": "node scripts/build-client.mjs",
    "build:check": "node scripts/build-client.mjs --check",
    "sync-data": "node scripts/sync-data.mjs",
    "sync-data:check": "node scripts/sync-data.mjs --check",
    "check:manifest": "node scripts/check-manifest.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check:manifest && npm run sync-data:check && npm run build:check && npm test"
  },
  "displayName": "dsh-pet-cuteness plugin",
  "peerDependenciesMeta": {
    "@linxin666/dsh-pet": {
      "optional": true
    }
  }
}
